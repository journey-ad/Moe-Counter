doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title='Moe Counter! · A visitor counter for your website'
    meta(name='description', content=`An image-based visitor counter for your README, blog or website, with ${themeCount} themes to choose from.`)
    meta(name='theme-color', content='#faf8f5')
    link(rel='icon', type='image/png', href=`${site}/favicon.png`)
    script.
      try {
        const appearance = localStorage.getItem('moe-counter-appearance');
        if (appearance === 'dark' || appearance === 'light') document.documentElement.dataset.appearance = appearance;
      } catch {}
    link(rel='stylesheet', href=`${site}/style.css`)
    //- 无构建，浏览器直接加载 ESM，裸模块名由 import map 解析
    script(type='importmap').
      {
        "imports": {
          "preact": "#{site}/vendor/preact.module.js",
          "preact/hooks": "#{site}/vendor/preact-hooks.module.js",
          "htm": "#{site}/vendor/htm.module.js"
        }
      }
    if ga_id
      <!-- Global site tag (gtag.js) - Google Analytics -->
      script(async, src=`https://www.googletagmanager.com/gtag/js?id=${ga_id}`)
    script.
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());

      gtag('config', '#{ga_id}');

      function _evt_push(type, category, label) {
        gtag('event', type, {
          'event_category' : category,
          'event_label' : label
        });
      }

    script(type='application/json', id='global-data') !{globalData}
    script(defer, src=`${site}/vendor/party.min.js`)

  body
    a.skip-link(href='#main') Skip to content

    div#app

    noscript
      h1 Moe Counter!
      p A visitor counter for your website. Replace <code>:name</code> with your own unique counter name.
      ul
        li Image URL: <code>#{site}/@:name</code>
        li HTML: <code>&lt;img src="#{site}/@:name" alt=":name" /&gt;</code>
        li Markdown: <code>![:name](#{site}/@:name)</code>
      p Enable JavaScript to customize your counter and browse themes.

    script(type='module', src=`${site}/app/main.js`)
